# Copy this file to .env and fill in real values before running the server.

PORT=4000

# The password required to unlock the admin vault.
ADMIN_PASSWORD="24434@$$#$"

# Used to sign admin session tokens. Change this to a long random string in production.
JWT_SECRET=change_this_to_a_long_random_string

# The URL your frontend runs on, so the backend can allow it through CORS.
FRONTEND_ORIGIN=http://localhost:5173
